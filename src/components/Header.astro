---
import { Image } from 'astro:assets';
import { mainShopLinks, supportLinks } from '../lib/storefront';
import type { SessionLocals } from '../lib/app-types';

const locals = Astro.locals as SessionLocals;
const user = locals.user;
const isStaff = locals.isStaff;

const authLinks = user
      ? [
          { label: 'Account', href: '/account' },
          ...(isStaff ? [{ label: 'Admin', href: '/admin' }] : []),
          { label: 'Logout', href: '/api/auth/logout' }
        ]
  : [{ label: 'Sign In', href: '/auth/login' }];

const featuredCategoryLabels = ['Laptops', 'Smartphones', 'Printers', 'Desktops'];
const desktopLinks = featuredCategoryLabels.flatMap((label) =>
  mainShopLinks.filter((link) => link.label === label)
);
const desktopSupportLinks = supportLinks.filter((link) => ['FAQ', 'Contact'].includes(link.label));
---

<header class="site-header">
  <div class="header-trust-bar">
    <div class="storefront-container header-trust-inner">
      <span>Tested devices</span>
      <span>Warranty included</span>
      <span>Nairobi pickup</span>
      <span>Countrywide delivery</span>
      <a href="https://wa.me/254720480475" target="_blank" rel="noreferrer">WhatsApp us</a>
    </div>
  </div>

  <div class="storefront-container header-shell">
    <a href="/" class="brand" aria-label="SES ICT HUB home">
      <span class="brand-mark">
        <Image
          src="/site-assets/ses-logo-header.svg"
          alt="SES ICT HUB logo"
          width={320}
          height={120}
          class="brand-logo"
          loading="eager"
          decoding="async"
        />
      </span>
    </a>

    <form class="header-search-form" action="/search" role="search">
        <label class="sr-only" for="header-search-input">Search products</label>
        <span aria-hidden="true" class="header-search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </span>
        <input
          id="header-search-input"
          type="search"
          name="q"
          placeholder="Search products"
          autocomplete="off"
        />
        <button type="submit">Search</button>
    </form>

    <div class="header-actions">
      <div class="desktop-account-links">
        {authLinks.map((link) => (
          <a href={link.href} class={`account-link ${link.label === 'Logout' ? 'muted' : ''}`}>{link.label}</a>
        ))}
      </div>

      <a href="/cart" class="cart-link" aria-label="View cart">
        <span class="cart-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
            <path d="M2.5 3h2l2.4 11.2a2 2 0 0 0 1.95 1.58h8.76a2 2 0 0 0 1.96-1.61l1.03-5.35H7.2" />
          </svg>
        </span>
        <span class="cart-label">Cart</span>
        <span id="cart-badge" class="cart-badge" aria-label="Cart items">0</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open site menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6.5" x2="21" y2="6.5"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17.5" x2="21" y2="17.5"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="desktop-nav-bar">
    <div class="storefront-container desktop-nav-inner">
      <nav class="desktop-nav" aria-label="Shop categories">
        <ul class="desktop-nav-list" role="list">
          <li>
            <details id="category-menu" class="category-menu">
              <summary class="desktop-nav-link category-menu-toggle">
                All Categories
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="mega-menu">
                <a href="/shop" class="all-products-link">Browse all products <span aria-hidden="true">→</span></a>
                <ul class="mega-menu-grid" role="list">
                  {mainShopLinks.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
          {desktopLinks.map((link) => (
            <li><a href={link.href} class="desktop-nav-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="desktop-support-links" aria-label="Support">
        {desktopSupportLinks.map((link) => (
          <a href={link.href} class="desktop-nav-link">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="storefront-container mobile-menu-inner">
      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Shop</p>
        <form class="mobile-search-form" action="/search" role="search">
          <label class="sr-only" for="mobile-search-input">Search products</label>
          <input
            id="mobile-search-input"
            type="search"
            name="q"
            placeholder="Search products"
            autocomplete="off"
          />
          <button type="submit">Search</button>
        </form>
        <ul class="mobile-menu-list" role="list">
          {mainShopLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <nav class="mobile-menu-block" aria-label="Support">
        <p class="mobile-menu-title">Support</p>
        <ul class="mobile-menu-list" role="list">
          {supportLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Account</p>
        <ul class="mobile-menu-list" role="list">
          {authLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <a href="/shop" class="pill-button primary mobile-menu-cta">Browse Shop</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid rgba(229, 231, 235, 0.86);
    background: #ffffff;
  }

  .header-trust-bar {
    background: #061633;
    color: #ffffff;
  }

  .header-trust-inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 1.85rem;
    overflow-x: auto;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    scrollbar-width: none;
  }

  .header-trust-inner::-webkit-scrollbar {
    display: none;
  }

  .header-trust-inner span {
    flex: 0 0 auto;
  }

  .header-trust-inner span::before {
    content: "✓";
    margin-right: 0.35rem;
    color: #6ee7b7;
  }

  .header-trust-inner a {
    flex: 0 0 auto;
    margin-left: auto;
    color: #ffffff;
  }

  .header-shell {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: 7rem;
    min-height: 3rem;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 2.625rem;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .desktop-nav-bar {
    display: none;
    border-top: 1px solid var(--color-border);
  }

  .desktop-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-support-links {
    display: flex;
    gap: var(--space-3);
  }

  .desktop-nav-link,
  .account-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: var(--color-text-soft);
    font-size: 0.86rem;
    font-weight: 800;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .desktop-nav-link:hover,
  .category-menu[open] > .desktop-nav-link,
  .account-link:hover {
    color: var(--color-primary);
  }

  .category-menu {
    position: relative;
  }

  .category-menu-toggle {
    gap: var(--space-1);
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
  }

  .category-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .category-menu-toggle svg {
    width: 1rem;
    height: 1rem;
  }

  .category-menu[open] .category-menu-toggle svg {
    transform: rotate(180deg);
  }

  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 100;
    width: min(36rem, calc(100vw - 2 * var(--storefront-gutter)));
    max-height: calc(100dvh - 11rem);
    overflow-y: auto;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: #ffffff;
    box-shadow: var(--shadow-lg);
  }

  .all-products-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--color-primary);
    font-weight: 800;
  }

  .mega-menu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem var(--space-1);
  }

  .mega-menu-grid a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .mega-menu-grid a:hover,
  .all-products-link:hover {
    background: var(--color-surface-strong);
  }

  .account-link.muted {
    color: #475569;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .desktop-account-links {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .header-search-form {
    display: none;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: 0.26rem 0.35rem 0.26rem 0.75rem;
    border: 1px solid rgba(203, 213, 225, 0.92);
    border-radius: 999px;
    background: rgba(248, 250, 252, 0.96);
    color: var(--color-text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  .header-search-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: #64748b;
    flex: 0 0 auto;
  }

  .header-search-form input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 700;
    outline: 0;
  }

  .header-search-form input::placeholder {
    color: #64748b;
  }

  .header-search-form button {
    flex: 0 0 auto;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 850;
    cursor: pointer;
  }

  .cart-link,
  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 1px solid rgba(226, 232, 240, 0.92);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text);
  }

  .cart-link {
    position: relative;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    font-weight: 700;
  }

  .cart-icon {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
  }

  .cart-label {
    display: none;
    font-size: 0.9rem;
  }

  .cart-badge {
    position: absolute;
    top: -0.35rem;
    right: -0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: #dc2626;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 10px 18px rgba(220, 38, 38, 0.22);
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .cart-badge[data-has-items="true"] {
    transform: scale(1);
  }

  .mobile-menu-toggle {
    width: 3rem;
    height: 3rem;
  }

  .mobile-menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .mobile-menu {
    border-bottom: 1px solid rgba(229, 231, 235, 0.92);
    background: rgba(255, 255, 255, 0.98);
    max-height: calc(100dvh - 10rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu-inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 1.5rem;
  }

  .mobile-menu-block {
    display: grid;
    gap: 0.7rem;
  }

  .mobile-menu-title {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-search-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .mobile-search-form input {
    min-width: 0;
    min-height: 2.85rem;
    padding: 0 0.95rem;
    border: 1px solid rgba(203, 213, 225, 0.92);
    border-radius: 999px;
    background: #f8fafc;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 700;
    outline: 0;
  }

  .mobile-search-form button {
    min-height: 2.85rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 850;
  }

  .mobile-menu-list {
    display: grid;
    gap: 0.15rem;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.55rem 0;
    font-size: 1rem;
    font-weight: 700;
    min-height: 2.75rem;
  }

  .mobile-menu-cta {
    width: 100%;
  }

  .site-header :is(a, button, summary, input):focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .header-trust-inner a:focus-visible {
    outline-color: #ffffff;
  }

  .header-search-form:focus-within {
    border-color: var(--color-primary);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @media (max-width: 719px) {
    .header-trust-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.32rem 0.72rem;
      min-height: 0;
      padding-block: 0.38rem;
      overflow: visible;
      font-size: 0.58rem;
      line-height: 1.2;
      text-align: center;
    }

    .header-trust-inner a {
      margin-left: 0;
    }
  }

  @media (min-width: 420px) {
    .cart-label {
      display: block;
    }
  }

  @media (min-width: 720px) {
    .header-shell {
      grid-template-columns: max-content minmax(0, 1fr) max-content;
      min-height: 5.5rem;
    }

    .brand {
      width: 8rem;
    }

    .brand-mark {
      height: 3rem;
    }

    .header-search-form {
      display: flex;
    }

    .mobile-menu-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-3);
    }
  }

  @media (min-width: 1200px) {
    .header-shell {
      gap: var(--space-4);
    }

    .desktop-nav-bar {
      display: block;
    }

    .desktop-account-links {
      display: flex;
    }

    .header-actions {
      gap: var(--space-3);
    }

    .mobile-menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const categoryMenu = document.getElementById('category-menu');
  const categoryToggle = categoryMenu?.querySelector('summary');

  function setMenuState(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close site menu' : 'Open site menu');
    menu.hidden = !open;
  }

  function updateCartBadge() {
    const cart = JSON.parse(localStorage.getItem('ses_cart') || '[]') as Array<{ qty?: number | string }>;
    const badge = document.getElementById('cart-badge');
    if (badge) {
      const quantity = cart.reduce((total, item) => total + Number(item.qty || 0), 0);
      badge.textContent = String(quantity);
      badge.dataset.hasItems = quantity > 0 ? 'true' : 'false';
    }
  }

  if (toggle instanceof HTMLButtonElement) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setMenuState(!expanded);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (categoryMenu instanceof HTMLDetailsElement && categoryMenu.open) {
        categoryMenu.open = false;
        categoryToggle?.focus();
      }
      if (toggle?.getAttribute('aria-expanded') === 'true') {
        toggle.focus();
      }
      setMenuState(false);
    }
  });

  document.addEventListener('click', (event) => {
    if (categoryMenu instanceof HTMLDetailsElement && event.target instanceof Node && !categoryMenu.contains(event.target)) {
      categoryMenu.open = false;
    }
  });

  categoryMenu?.addEventListener('focusout', (event) => {
    if (categoryMenu instanceof HTMLDetailsElement && event.relatedTarget instanceof Node && !categoryMenu.contains(event.relatedTarget)) {
      categoryMenu.open = false;
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1200) {
      setMenuState(false);
    } else if (categoryMenu instanceof HTMLDetailsElement) {
      categoryMenu.open = false;
    }
  });

  updateCartBadge();
  window.addEventListener('pageshow', updateCartBadge);
  window.addEventListener('storage', updateCartBadge);
  window.addEventListener('cart-updated', updateCartBadge);
</script>
