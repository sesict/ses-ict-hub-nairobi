{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ses-hub-superbase-stack-app",
  "account_id": "4b4295025db1d29a5f0a52288da307bb",
  "main": "dist/server/entry.mjs",
  "workers_dev": true,
  "compatibility_date": "2026-03-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "no_bundle": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "34f3820170084665891b64c9a012a37c",
      "preview_id": "a4f71bdd496b43838fe312d1bbe22c6f"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "sesicthub.co.ke",
      "custom_domain": true,
      "zone_id": "f1b6d3e1359d5c5837ce547c0da54ccc"
    }
  ]
}
